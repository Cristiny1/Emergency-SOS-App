<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow / Shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33C22026" />
        </shape>
    </item>

    <!-- Main Button Body with 3D Gradient -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#A01D22"
                android:startColor="#E53935"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- Inner Glossy Highlight -->
    <item android:bottom="40dp" android:left="20dp" android:right="20dp" android:top="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>