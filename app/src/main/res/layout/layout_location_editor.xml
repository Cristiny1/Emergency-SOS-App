<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/province_label"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <Spinner
        android:id="@+id/spinnerProvince"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/district_label"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <Spinner
        android:id="@+id/spinnerDistrict"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/commune_label"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <EditText
        android:id="@+id/etCommune"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        android:hint="@string/enter_commune_hint"
        android:padding="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/village_label"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <EditText
        android:id="@+id/etVillage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        android:hint="@string/enter_village_hint"
        android:padding="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/home_address_label"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <EditText
        android:id="@+id/etHomeAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        android:hint="@string/address_details_hint"
        android:padding="14dp"
        android:textSize="14sp" />

</LinearLayout>
