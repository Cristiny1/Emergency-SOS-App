<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMemberName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMemberRelationship"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_tag"
                    android:backgroundTint="#1A1877F2"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="MOM"
                    android:textColor="@color/fb_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMemberPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phone"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_green"
            android:padding="8dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/white"
            android:contentDescription="Call" />

        <ImageView
            android:id="@+id/btnMessage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_blue"
            android:padding="8dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/white"
            android:contentDescription="Message" />

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#0367FF"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/white"
            android:contentDescription="Edit" />

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#EF0A0A"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/white"
            android:contentDescription="Delete" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
