<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Bot Message Bubble -->
    <LinearLayout
        android:id="@+id/botContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_chat_bubble_bot"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvBotMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bot Message"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- AI Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutAiActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAiActionSOS"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/sos_red"
                android:text="🚨 ACTIVATE SOS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnAiActionCall"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/green_verified"
                android:text="📞 CALL EMERGENCY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- User Message Bubble -->
    <LinearLayout
        android:id="@+id/userContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_chat_bubble_user"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Message"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

</LinearLayout>
